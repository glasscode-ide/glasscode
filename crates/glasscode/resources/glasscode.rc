// The icon and the version of Glasscode.exe, compiled by build.rs on Windows. There is no manifest
// here: vendor/gpui embeds the manifest, and a program has one.

// build.rs writes this file with the version of the build.
#include "glasscode_version.h"

// The window takes the icon with the number 1 (load_icon in vendor/gpui_windows); File Explorer,
// the taskbar and the Start menu take it too.
1 ICON "Glasscode.ico"

// 1 is VS_VERSION_INFO. The other numbers are the constants of winver.h, written out so that this
// file needs no header of the Windows SDK.
1 VERSIONINFO
FILEVERSION GLASSCODE_VERSION
PRODUCTVERSION GLASSCODE_VERSION
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "The Glasscode authors"
            VALUE "FileDescription", "Glasscode"
            VALUE "FileVersion", GLASSCODE_VERSION_TEXT
            VALUE "InternalName", "glasscode"
            VALUE "LegalCopyright", "Copyright (C) 2026 The Glasscode authors"
            VALUE "OriginalFilename", "Glasscode.exe"
            VALUE "ProductName", "Glasscode"
            VALUE "ProductVersion", GLASSCODE_PRODUCT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
