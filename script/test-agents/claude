def find_rollout(home, sid):
    for root, _, files in os.walk(os.path.join(home, "sessions")):
        for name in sorted(files):
            if sid in name and name.endswith(".jsonl"):
                return os.path.join(root, name)
    return None


def hook_trust(home):
    """The `hooks.state` trust entries of CODEX_HOME's config.toml, by key: their trusted_hash."""
    try:
        text = open(os.path.join(home, "config.toml"), encoding="utf-8").read()
    except OSError:
        return {}
    found, key = {}, None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            key = None
            if line.startswith("[hooks.state.") and line.endswith("]"):
                inner = line[len("[hooks.state."):-1]
                key = json.loads(inner) if inner.startswith('"') else inner
        elif key and line.startswith("trusted_hash"):
            found[key] = json.loads(line.split("=", 1)[1].strip())
    return found


def app_server(home):
    """`codex app-server` on stdio, as far as Glasscode asks it (P06): `initialize`, then
    `hooks/list`, which reads CODEX_HOME's hooks.json. Each handler's key is
    `<file>:<event>:<group>:<handler>`, its hash the sha256 of its definition, and it is trusted
    when config.toml's `hooks.state` holds that hash for its key."""
    path = os.path.join(home, "hooks.json")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if "id" not in message:
            continue
        method = message.get("method")
        if method == "initialize":
            result = {"userAgent": "codex-stand-in"}
        elif method == "hooks/list":
            try:
                defined = json.load(open(path, encoding="utf-8")).get("hooks", {})
            except (OSError, ValueError):
                defined = {}
            trust = hook_trust(home)
            hooks = []
            for event, groups in defined.items():
                snake = re.sub(r"(?<!^)([A-Z])", r"_\1", event).lower()
                for gi, group in enumerate(groups):
                    for hi, handler in enumerate(group.get("hooks", [])):
                        key = f"{path}:{snake}:{gi}:{hi}"
                        current = "sha256:" + hashlib.sha256(json.dumps(handler, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
                        status = "trusted" if trust.get(key) == current else ("modified" if key in trust else "untrusted")
                        hooks.append({"key": key, "source": "user", "eventName": event[0].lower() + event[1:], "command": handler.get("command"), "currentHash": current, "trustStatus": status})
            result = {"data": [{"cwd": (message.get("params", {}).get("cwds") or [""])[0], "hooks": hooks, "warnings": []}]}
        else:
            out(json.dumps({"jsonrpc": "2.0", "id": message["id"], "error": {"code": -32601, "message": f"{method} is not imitated"}}) + "\n")
            continue
        out(json.dumps({"jsonrpc": "2.0", "id": message["id"], "result": result}) + "\n")


def codex(args, help_texts, version):
    main = help_texts.get("codex --help", "")
    opts = options(main)
    opts.setdefault("--version", ("none", "--version"))
    flags, positionals, command, rest = parse(args, opts, commands(main) | {"e"}, clap=True)
    command = "exec" if command == "e" else command
    sub = help_texts.get(f"codex {command} --help", main) if command else main
    if command:
        sub_opts = dict(opts)
        sub_opts.update(options(sub))
        more, positionals, inner, inner_rest = parse(rest, sub_opts, commands(sub), clap=True)
        flags.update(more)
        if inner:
            # `codex exec resume <id> [prompt]`: the options of exec go on.
            more, positionals, _, _ = parse(inner_rest, sub_opts, set(), clap=True)
            flags.update(more)
            positionals = [inner] + positionals
    if flags.get("--help"):
        out(sub)
        finish(0)
    if flags.get("--version"):
        out(help_texts.get("codex --version", "codex-cli " + version + "\n"))
        finish(0)
    home = scratch("CODEX_HOME")
    check_only(home)
    if command == "login":
        print("Stand-in Codex login: nothing to sign in to. Writing an empty auth.json in CODEX_HOME.")
        with open(os.path.join(home, "auth.json"), "w", encoding="utf-8") as f:
            f.write("{}")
        finish(0)
    if command == "app-server":
        app_server(home)
        finish(0)
    if command not in (None, "exec", "resume"):
        fail(1, f"codex stand-in: `codex {command}` is not imitated")
    exec_mode = command == "exec"
    resume_id = None
    if command == "resume" or (exec_mode and positionals[:1] == ["resume"]):
        if exec_mode:
            positionals = positionals[1:]
        if not positionals:
            fail(1, "codex stand-in: resume needs a session id (--last is not imitated)")
        resume_id, positionals = positionals[0], positionals[1:]
    scenario = scenario_for("-exec" if exec_mode else "")
    start = start_ms(scenario)
    cwd = last(flags, "--cd") or os.getcwd()
    if resume_id:
        sid = resume_id
        rollout = find_rollout(home, sid)
        if not rollout:
            fail(1, f"Error: No saved session found with ID {sid}")
    else:
        sid = os.environ.get("GLASSCODE_TEST_SESSION_ID") or str(uuid.uuid4())
        stamp = iso(start if start is not None else wall_ms())
        day = os.path.join(home, "sessions", stamp[:4], stamp[5:7], stamp[8:10])
        rollout = os.path.join(day, f"rollout-{stamp[:10]}T{stamp[11:19].replace(':', '-')}-{sid}.jsonl")
    values = {
        "session_id": sid,
        "cwd": cwd,
        "branch": branch(cwd),
        "originator": "codex_exec" if exec_mode else "codex_cli_rs",
        "source": "exec" if exec_mode else "cli",
    }
    player = Player(scenario, values, {"rollout": rollout, "history": os.path.join(home, "history.jsonl")}, {}, cwd, start)
    if resume_id:
        # A resumed conversation goes on in its rollout: its start is not written again.
        player.scenario = dict(scenario, start=[])
    prompt = " ".join(positionals) if positionals else None
    if exec_mode:
        player.output = "raw" if flags.get("--json") else "text"
        if prompt in (None, "-"):
            prompt = sys.stdin.read().strip()
        session(player, [prompt], interactive=False)
    session(player, [prompt] if prompt else [], interactive=True)


def main():
    found = help_files()
    wanted = os.environ.get(f"GLASSCODE_TEST_{AGENT.upper()}_VERSION")
    chosen = next((f for f in found if f[1] == wanted), None) if wanted else (found[-1] if found else None)
    if not chosen:
        fail(3, f"{AGENT} stand-in: no recorded help of {AGENT}{' ' + wanted if wanted else ''} in {os.path.abspath(help_folder())} (set GLASSCODE_TEST_CLI_HELP to script/cli-help)")
    help_texts = sections(chosen[2])
    version = chosen[1]
    (codex if AGENT == "codex" else claude)(sys.argv[1:], help_texts, version)


if __name__ == "__main__":
    main()
