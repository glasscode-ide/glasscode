<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Programs in Glasscode's terminals (Claude Code's /voice, scripts using the camera or
  AppleScript) get macOS privacy permissions through Glasscode, the app that started them.
  With the hardened runtime (Developer ID builds) these entitlements are required for that.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
