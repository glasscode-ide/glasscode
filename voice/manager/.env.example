# Copy to .env (same folder) and fill in. Nothing here is a real key.

# ---- LiveKit: the room server. You make this key and secret yourself: ----
#   docker run --rm livekit/livekit-server:v1.13.11 generate-keys
# The same two values go into Glasscode (Settings › Manager › Voice).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The address the Mac and the phone reach this machine at, for the audio itself.
# In a home or office network or a VPN (Tailscale, WireGuard): this machine's address there,
# for example 192.168.1.20 or 100.x.y.z. On a machine with a public address: leave it empty
# and set LIVEKIT_USE_EXTERNAL_IP=true.
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=false

# Only with `docker compose --profile tls up -d`: the name the certificate is made for.
LIVEKIT_DOMAIN=

# ---- Speech to text: one of deepgram | openai | elevenlabs ----
MANAGER_STT=deepgram
# ---- Text to speech: one of cartesia | elevenlabs | openai | deepgram ----
MANAGER_TTS=cartesia
# The voice, as the text-to-speech service names it. Empty: its default voice.
MANAGER_VOICE=
# The language you speak to it ("en", "de", ...; with Deepgram "multi" follows mixed languages).
MANAGER_LANGUAGE=en

# The keys of the services chosen above (only those are needed).
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=

# ---- Optional ----
# The manager's name until Glasscode sends it (it does when it connects).
MANAGER_NAME=Manager
# stream: the microphone goes to speech to text as it comes (fastest).
# segments: only what sounds like speech is sent, sentence by sentence (less is sent and paid for).
MANAGER_STT_MODE=stream
# How long after the manager spoke you can answer without saying its name (seconds).
MANAGER_WINDOW_SECS=20
# 1: the worker's log shows what it understood and whether it passed it on (to find out why
# it does not react to its name). Leave it off otherwise.
MANAGER_LOG_HEARD=
# client: Glasscode on the Mac answers (default). server: `glasscoded manager ask` on this
# machine answers; see README.md ("The brain on the server").
MANAGER_BRAIN=client
